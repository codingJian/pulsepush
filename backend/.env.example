# Copy to .env and fill in. Never commit .env or any service-account JSON.
DATABASE_URL=sqlite+aiosqlite:///./webhook_push.db
# For PostgreSQL: postgresql+asyncpg://user:password@127.0.0.1:5432/webhook_push
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=7
# Path to the Firebase service-account JSON on the server.
# Leave empty for dry-run mode (no real FCM sends, push responses carry dry_run:true).
FIREBASE_CREDENTIALS=/opt/webhook-push/firebase-service-account.json
BASE_URL=http://localhost:8000
RATE_LIMIT_PER_MINUTE=60
